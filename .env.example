# Public frontend URLs for the connector widget (not in this repository).
# Leave empty to use the localhost defaults in nuxt.config.ts.
NUXT_PUBLIC_CONNECTOR_SCRIPT_URL=
NUXT_PUBLIC_STATIC_URL=
NUXT_PUBLIC_CONNECTOR_API_URL=

# Public on-chain addresses (hex). Defaults live in nuxt.config.ts.
NUXT_PUBLIC_WX=
NUXT_PUBLIC_TOKEN=
NUXT_PUBLIC_STAKING=
